---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { EPIGRAPH_AR, langPaths, t, url, type Lang } from '../../lib/i18n';
import { THEMES } from '../../lib/themes';
import { getArticles } from '../../lib/articles';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
const articles = (await getArticles(lang)).slice(0, 6);
---
<Base lang={lang}>
  <section class="hero">
    <div class="wrap narrow">
      <h1>{s.siteName}</h1>
      <p class="lede">{s.tagline}</p>
      <figure class="epigraph">
        <blockquote>
          <p class="ayah" lang="ar" dir="rtl">{EPIGRAPH_AR}</p>
          {s.epigraph && <p class="translation">{s.epigraph}</p>}
        </blockquote>
        <figcaption>{s.epigraphRef}</figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>{s.latest}</h2>
      {articles.length > 0 && <a href={url(`${lang}/articles/`)}>{s.allArticles} →</a>}
    </div>
    {articles.length
      ? <div class="grid">{articles.map((a) => <ArticleCard article={a} lang={lang} />)}</div>
      : <p class="empty">{s.empty}</p>}
  </section>

  <section class="wrap section">
    <div class="section-head"><h2>{s.exploreThemes}</h2></div>
    <div class="themes">
      {THEMES.map((th) => (
        <a class="theme" href={url(`${lang}/themes/${th.slug}/`)}>
          <strong>{th.name[lang]}</strong>
          <span>{th.description[lang]}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
