---
// Eight-pointed star (khātam) — the site's emblem.
const { size = 28 } = Astro.props;
---
<svg class="mark" width={size} height={size} viewBox="0 0 40 40" aria-hidden="true">
  <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
    <rect x="8" y="8" width="24" height="24" />
    <rect x="8" y="8" width="24" height="24" transform="rotate(45 20 20)" />
    <circle cx="20" cy="20" r="5" />
  </g>
</svg>
